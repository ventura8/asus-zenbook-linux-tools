#: bin/asus_install_selection_tui.py:525
#, python-format
msgid "Installing ASUS ZenBook Linux Tools %s."
msgstr "%s Seta ASUS ZenBook Linux tól upp."

#: lib/install-selection.sh:169
msgid ""
"Installs the WMI hotkey daemon for ScreenPad brightness, fan Quiet/Balanced/"
"Performance, camera privacy, and window swap across monitors."
msgstr ""
"Leggur WMI-hotkey-demon inn fyri ScreenPad-ljóma, vifta Quiet/Balanced/"
"Performance, kameraprivatlív og vindeyðaskifti millum skjármar."

#: lib/install-selection.sh:173
msgid ""
"Installs the speaker amplifier fix and a suspend/resume hook so supported "
"ZenBook audio recovers after boot and after sleep."
msgstr ""
"Leggur hátalaraforsterkara-rætting og suspend/resume-krók inn, so stuðlað "
"ZenBook-ljóð kemur aftur eftir start og eftir svøvn."

#: lib/install-selection.sh:171
msgid ""
"Installs the touchpad Share gesture listener so a top-left corner tap opens "
"your desktop screenshot tool (GNOME, Spectacle, and peers)."
msgstr ""
"Leggur touchpad Share-gestuslustara inn, so eitt trýst uppi til vinstru "
"letur upp screendump-amboðið á skriviborðinum (GNOME, Spectacle og líknandi)."

#: lib/install-selection.sh:197
