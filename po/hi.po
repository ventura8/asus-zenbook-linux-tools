#: bin/asus_install_selection_tui.py:527
#, python-format
msgid ""
"Select only the components you use. Unselected services and shortcuts will "
"not be installed."
msgstr ""
"केवल आपके द्वारा उपयोग किए जाने वाले घटकों का चयन करें। अचयनित सेवाएँ और शॉर्टकट स्थापित "
"नहीं किए जाएंगे।"

#: lib/install-selection.sh:164
msgid "Select only what you use to avoid unnecessary services and shortcuts."
msgstr "अनावश्यक सेवाओं और शॉर्टकट से बचने के लिए केवल वही चुनें जिसका आप उपयोग करते हैं।"

#: lib/install-gnome.sh:333
