#: bin/asus_install_selection_tui.py:527
#, python-format
msgid ""
"Select only the components you use. Unselected services and shortcuts will "
"not be installed."
msgstr ""
"तपाईंले प्रयोग गर्नुहुने घटकहरू मात्र चयन गर्नुहोस्। चयन नगरिएका सेवाहरू र सर्टकटहरू स्थापना "
"गरिने छैनन्।"

#: lib/install-selection.sh:160
msgid "Select only what you use to avoid unnecessary services and shortcuts."
msgstr "अनावश्यक सेवाहरू र सर्टकटहरूबाट बच्न तपाईंले प्रयोग गर्ने मात्र चयन गर्नुहोस्।"

