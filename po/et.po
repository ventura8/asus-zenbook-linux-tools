msgstr "Heliparandus on paigaldatud peatamis- ja jätkamiskonksuga."

#: lib/install-selection-tui.sh:25
msgid "Space selects a component. Enter confirms. Esc cancels."
msgstr "Space valib komponendi. Enter kinnitab. Esc tühistab."

#: lib/install-selection.sh:186
msgid "Text selection mode."
msgstr "Teksti valimise režiim."

#: lib/install-selection.sh:177
msgid "The interface language follows your desktop session."
msgstr "Liidese keel järgib teie töölaua seanssi."

#: lib/install-os-detection.sh:566
msgid ""
"This can take a few minutes while packages are downloaded and installed."
msgstr ""
"See võib võtta mõne minuti, kuni paketid alla laaditakse ja installitakse."

