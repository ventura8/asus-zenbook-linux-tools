#: lib/install-selection.sh:186
msgid "Press Enter to install all recommended components, or enter 'all'."
msgstr ""
"Tsindrio Enter hametrahana ny singa rehetra atolotra, na manorata 'all'."

#: bin/asus-fan-toggle.sh:95
msgid "Quiet (Silent)"
msgstr "Mangina (mangina)"

#: bin/asus-screenpad-toggle.sh:72
msgid "ScreenPad backlight"
msgstr "Jiro ambadiky ny ScreenPad"

#: lib/asus-screenpad.sh:456
msgid "ScreenPad brightness"
msgstr "Famirapiratry ny ScreenPad"

#: lib/asus-display-mutter.sh:82
msgid "ScreenPad only"
msgstr "ScreenPad ihany"

#: bin/asus_install_selection_tui.py:527
#, python-format
msgid ""
"Select only the components you use. Unselected services and shortcuts will "
"not be installed."
msgstr ""
"Fidio ireo singa ampiasainao ihany. Serivisy tsy voafantina sy hitsin-dàlana "
"tsy hapetraka."

#: lib/install-selection.sh:160
msgid "Select only what you use to avoid unnecessary services and shortcuts."
msgstr ""
"Fidio izay ampiasainao ihany mba hialana amin'ny serivisy sy hitsin-dàlana "
"tsy ilaina."

#: lib/install-gnome.sh:333
msgid ""
"Shortcuts registered for Print/Super-Shift-s, XF86Launch1/XF86Tools, and "
"XF86Display (F8 left unchanged)."
msgstr ""
"Shortcuts voasoratra ho an'ny Print/Super-Shift-s, XF86Launch1/XF86Tools, "
"ary XF86Display (F8 navela tsy niova)."

#: lib/install-components.sh:543
msgid "Sound fix installed with a suspend and resume hook."
msgstr ""
"Napetraka miaraka amin'ny fatorana fampiatoana sy famerenana indray ny "
"fanamboarana feo."

#: lib/install-selection-tui.sh:25
msgid "Space selects a component. Enter confirms. Esc cancels."
msgstr "Misafidy singa i Space. Manamarina i Enter. Manafoana i Esc."

#: lib/install-selection.sh:182
msgid "Text selection mode."
msgstr "Fomba fisafidianana lahatsoratra."

#: lib/install-selection.sh:173
msgid "The interface language follows your desktop session."
msgstr "Ny fiteny interface dia manaraka ny session desktop-nao."

#: lib/install-os-detection.sh:566
msgid ""
"This can take a few minutes while packages are downloaded and installed."
msgstr ""
"Mety haharitra minitra vitsivitsy izany raha ampidinina sy apetraka ny "
"packages."

#: lib/install-components.sh:425
msgid ""
"Touchpad Share gesture listener installed (active state not verified in this "
"environment)."
msgstr ""
"Touchpad Share gesture listener napetraka (tsy voamarina amin'ity tontolo "
"ity ny toe-javatra mavitrika)."

#: lib/install-components.sh:420
msgid "Touchpad Share gesture listener installed and active."
msgstr "Touchpad Share gesture listener napetraka sy mavitrika."

#: lib/install-components.sh:68
msgid ""
"WMI Hotkey daemon installed (active state not verified in this environment)."
msgstr ""
"WMI Hotkey daemon napetraka (fanjakana mavitrika tsy voamarina amin'ity "
"tontolo ity)."

#: lib/install-components.sh:63
msgid "WMI Hotkey daemon installed and active."
msgstr "WMI Hotkey daemon napetraka sy mavitrika."

