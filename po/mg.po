#: bin/asus_install_selection_tui.py:525
#, python-format
msgid "Installing ASUS ZenBook Linux Tools %s."
msgstr "Fametrahana ASUS ZenBook Linux Tools %s."

#: lib/install-selection.sh:165
msgid ""
"Installs the WMI hotkey daemon for ScreenPad brightness, fan Quiet/Balanced/"
"Performance, camera privacy, and window swap across monitors."
msgstr ""
"Mametraka ny daemon hotkey WMI ho an'ny fahazavan'ny ScreenPad, ny "
"ventilateur Quiet/Balanced/Performance, ny fiainam-bahoaka kamera, ary ny "
"fifanakalozana varavarankely eo amin'ny monitor."

#: lib/install-selection.sh:169
msgid ""
"Installs the speaker amplifier fix and a suspend/resume hook so supported "
"ZenBook audio recovers after boot and after sleep."
msgstr ""
"Mametraka ny fanamboarana amplifier speaker ary hook suspend/resume mba "
"hiverenan'ny feo ZenBook tohanana aorian'ny boot ary aorian'ny fatoriana."

#: lib/install-selection.sh:167
msgid ""
"Installs the touchpad Share gesture listener so a top-left corner tap opens "
"your desktop screenshot tool (GNOME, Spectacle, and peers)."
msgstr ""
"Mametraka ny listener gesture Share amin'ny touchpad mba hanokafana ny "
"fitaovana screenshot desktop (GNOME, Spectacle ary mitovy) rehefa mikitika "
"ny zoro havia ambony."

#: lib/install-selection.sh:193
#, sh-format
msgid ""
"Invalid selection: %s. Enter numbers (1,2,3,4), component names, or all."
msgstr "Safidy tsy mety: %s. Ampidiro isa (1,2,3,4), anaran'ny singa, na all."

#: lib/install-kde.sh:309
msgid "KDE Plasma shortcuts configured."
msgstr "KDE Plasma hitsin-dàlana voarindra."

#: lib/install-lxqt.sh:582
msgid "LXQt Global Keys configured."
msgstr "LXQt Global Keys namboarina."

#: lib/install-mate.sh:205
msgid "MATE shortcuts configured."
msgstr "Voafefy ny hitsin-dàlana MATE."

