#, python-format
msgid ""
"Select only the components you use. Unselected services and shortcuts will "
"not be installed."
msgstr ""
"Vælg kun de komponenter, du bruger. Ikke-valgte tjenester og genveje vil "
"ikke blive installeret."

#: lib/install-selection.sh:164
msgid "Select only what you use to avoid unnecessary services and shortcuts."
msgstr "Vælg kun det, du bruger for at undgå unødvendige tjenester og genveje."

