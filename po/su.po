#: bin/asus_install_selection_tui.py:528
#, python-format
msgid ""
"Select only the components you use. Unselected services and shortcuts will "
"not be installed."
msgstr ""
"Pilih ukur komponén anu anjeun anggo. Ladenan sareng potong kompas anu "
"henteu dipilih moal dipasang."

#: lib/install-selection.sh:164
msgid "Select only what you use to avoid unnecessary services and shortcuts."
msgstr ""
"Pilih naon waé anu anjeun anggo pikeun ngahindarkeun jasa sareng potong "
"kompas anu teu perlu."

