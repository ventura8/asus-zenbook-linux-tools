#: bin/asus_install_selection_tui.py:525
#, python-format
msgid "Installing ASUS ZenBook Linux Tools %s."
msgstr "Installacion d'ASUS ZenBook Linux Tools %s."

#: lib/install-selection.sh:165
msgid ""
"Installs the WMI hotkey daemon for ScreenPad brightness, fan Quiet/Balanced/"
"Performance, camera privacy, and window swap across monitors."
msgstr ""
"Installa lo demòni de tòcas rapidas WMI per la luminositat ScreenPad, lo "
"ventilador Quiet/Balanced/Performance, la privacitat de la camèra e "
"l'escambi de fenèstras entre monitores."

#: lib/install-selection.sh:169
msgid ""
"Installs the speaker amplifier fix and a suspend/resume hook so supported "
"ZenBook audio recovers after boot and after sleep."
msgstr ""
"Installa la correccion de l'amplificador dels nautparlaires e un gancho "
"suspend/resume per que l'àudio ZenBook suportat se restablisca aprèp "
"l'aviada e aprèp la mesa en velha."

#: lib/install-selection.sh:167
msgid ""
"Installs the touchpad Share gesture listener so a top-left corner tap opens "
"your desktop screenshot tool (GNOME, Spectacle, and peers)."
msgstr ""
"Installa l'escotaire del gèst Share del pavé tacile per qu'un tocat al "
"canton superior esquèrra dobrisca l'aisina de captura del burèu (GNOME, "
"Spectacle e similars)."

#: lib/install-selection.sh:193
#, sh-format
