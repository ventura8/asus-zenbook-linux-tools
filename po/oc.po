#: bin/asus_install_selection_tui.py:527
#, python-format
msgid ""
"Select only the components you use. Unselected services and shortcuts will "
"not be installed."
msgstr ""
"Seleccionatz pas que los compausants qu'utilizatz. Los servicis e los "
"acorchis non seleccionats seràn pas installats."

#: lib/install-selection.sh:160
msgid "Select only what you use to avoid unnecessary services and shortcuts."
msgstr ""
"Seleccionatz sonque çò qu'utilizatz per evitar de servicis e d'acorchis "
"inutiles."

