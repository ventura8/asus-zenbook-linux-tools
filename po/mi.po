#: lib/install-selection.sh:186
msgid "Press Enter to install all recommended components, or enter 'all'."
msgstr ""
"Pēhia a Enter ki te tāuta i ngā wāhanga katoa e tūtohutia ana, pe tāuruhia "
"'all'."

#: bin/asus-fan-toggle.sh:95
msgid "Quiet (Silent)"
msgstr "Ata (Wahangu)"

#: bin/asus-screenpad-toggle.sh:72
msgid "ScreenPad backlight"
