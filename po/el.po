#: bin/asus_install_selection_tui.py:525
#, python-format
msgid "Installing ASUS ZenBook Linux Tools %s."
msgstr "Εγκατάσταση ASUS ZenBook Linux Tools %s."

#: lib/install-selection.sh:165
msgid ""
"Installs the WMI hotkey daemon for ScreenPad brightness, fan Quiet/Balanced/"
"Performance, camera privacy, and window swap across monitors."
msgstr ""
"Εγκαθιστά τον δαίμονα πλήκτρων WMI για φωτεινότητα ScreenPad, ανεμιστήρα "
"Quiet/Balanced/Performance, απόρρητο κάμερας και εναλλαγή παραθύρων μεταξύ "
"οθονών."

#: lib/install-selection.sh:169
msgid ""
"Installs the speaker amplifier fix and a suspend/resume hook so supported "
"ZenBook audio recovers after boot and after sleep."
msgstr ""
"Εγκαθιστά τη διόρθωση ενισχυτή ηχείων και ένα άγκιστρο suspend/resume ώστε ο "
"υποστηριζόμενος ήχος ZenBook να επανέρχεται μετά την εκκίνηση και μετά τον "
"ύπνο."

#: lib/install-selection.sh:167
msgid ""
"Installs the touchpad Share gesture listener so a top-left corner tap opens "
"your desktop screenshot tool (GNOME, Spectacle, and peers)."
msgstr ""
"Εγκαθιστά τον ακροατή χειρονομίας Share του touchpad ώστε πάτημα στην επάνω "
"αριστερή γωνία να ανοίγει το εργαλείο στιγμιοτύπων της επιφάνειας εργασίας "
"(GNOME, Spectacle κ.ά.)."

#: lib/install-selection.sh:193
#, sh-format
msgid ""
"Invalid selection: %s. Enter numbers (1,2,3,4), component names, or all."
msgstr ""
"Μη έγκυρη επιλογή: %s. Εισαγάγετε αριθμούς (1,2,3,4), ονόματα στοιχείων ή "
"all."

