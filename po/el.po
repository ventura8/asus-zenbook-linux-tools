#: bin/asus_install_selection_tui.py:527
#, python-format
msgid ""
"Select only the components you use. Unselected services and shortcuts will "
"not be installed."
msgstr ""
"Επιλέξτε μόνο τα εξαρτήματα που χρησιμοποιείτε. Οι μη επιλεγμένες υπηρεσίες "
"και οι συντομεύσεις δεν θα εγκατασταθούν."

#: lib/install-selection.sh:160
msgid "Select only what you use to avoid unnecessary services and shortcuts."
msgstr ""
"Επιλέξτε μόνο αυτό που χρησιμοποιείτε για να αποφύγετε περιττές υπηρεσίες "
"και συντομεύσεις."

#: lib/install-gnome.sh:333
msgid ""
"Shortcuts registered for Print/Super-Shift-s, XF86Launch1/XF86Tools, and "
"XF86Display (F8 left unchanged)."
msgstr ""
"Εγγεγραμμένες συντομεύσεις για Print/Super-Shift-s, XF86Launch1/XF86Tools "
"και XF86Display (Το F8 έμεινε αμετάβλητο)."

#: lib/install-components.sh:543
msgid "Sound fix installed with a suspend and resume hook."
msgstr ""
"Ηχητική επισκευή έχει εγκατασταθεί με άγκιστρο ανάρτησης και επαναφοράς."

#: lib/install-selection-tui.sh:25
msgid "Space selects a component. Enter confirms. Esc cancels."
msgstr "Space επιλέγει στοιχείο. Enter επιβεβαιώνει. Esc ακυρώνει."

#: lib/install-selection.sh:182
msgid "Text selection mode."
msgstr "Λειτουργία επιλογής κειμένου."

#: lib/install-selection.sh:173
msgid "The interface language follows your desktop session."
msgstr ""
"Η γλώσσα διεπαφής ακολουθεί την περίοδο λειτουργίας της επιφάνειας εργασίας "
"σας."

#: lib/install-os-detection.sh:566
msgid ""
"This can take a few minutes while packages are downloaded and installed."
msgstr ""
"Αυτό μπορεί να διαρκέσει λίγα λεπτά όσο γίνεται λήψη και εγκατάσταση πακέτων."

#: lib/install-components.sh:425
msgid ""
"Touchpad Share gesture listener installed (active state not verified in this "
"environment)."
msgstr ""
"Εγκαταστάθηκε το πρόγραμμα ακρόασης χειρονομιών κοινής χρήσης επιφάνειας "
"αφής (η ενεργή κατάσταση δεν έχει επαληθευτεί σε αυτό το περιβάλλον)."

#: lib/install-components.sh:420
msgid "Touchpad Share gesture listener installed and active."
msgstr ""
"Το πρόγραμμα ακρόασης χειρονομιών κοινής χρήσης επιφάνεια αφής είναι "
"εγκατεστημένο και ενεργό."

#: lib/install-components.sh:68
msgid ""
"WMI Hotkey daemon installed (active state not verified in this environment)."
msgstr ""
"Εγκαταστάθηκε ο δαίμονας του WMI Hotkey (η ενεργή κατάσταση δεν έχει "
"επαληθευτεί σε αυτό το περιβάλλον)."

#: lib/install-components.sh:63
msgid "WMI Hotkey daemon installed and active."
msgstr "Ο δαίμονας WMI Hotkey είναι εγκατεστημένος και ενεργός."

