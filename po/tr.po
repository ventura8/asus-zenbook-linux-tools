#: bin/asus_install_selection_tui.py:527
#, python-format
msgid ""
"Select only the components you use. Unselected services and shortcuts will "
"not be installed."
msgstr ""
"Yalnızca kullandığınız bileşenleri seçin. Seçilmeyen hizmetler ve kısayollar "
"yüklenmeyecektir."

#: lib/install-selection.sh:164
msgid "Select only what you use to avoid unnecessary services and shortcuts."
msgstr ""
"Gereksiz hizmetlerden ve kısayollardan kaçınmak için yalnızca kullandığınızı "
"seçin."

