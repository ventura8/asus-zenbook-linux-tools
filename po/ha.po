#: bin/asus_install_selection_tui.py:526
#, python-format
msgid "Installing ASUS ZenBook Linux Tools %s."
msgstr "Shigar da ASUS ZenBook Linux Tools %s."

#: lib/install-selection.sh:169
msgid ""
"Installs the WMI hotkey daemon for ScreenPad brightness, fan Quiet/Balanced/"
"Performance, camera privacy, and window swap across monitors."
msgstr ""
"Yana shigar da aljanin hotkey na WMI don hasken ScreenPad, fanka Quiet/"
"Balanced/Performance, sirri na kyamara da musayar tagogi tsakanin monito."

#: lib/install-selection.sh:173
msgid ""
"Installs the speaker amplifier fix and a suspend/resume hook so supported "
"ZenBook audio recovers after boot and after sleep."
msgstr ""
"Yana shigar da gyaran amplifier ɗin lasifika da ƙugiya ta suspend/resume don "
"sautin ZenBook da ake goyan baya ya farfado bayan kunna da bayan barci."

#: lib/install-selection.sh:171
msgid ""
"Installs the touchpad Share gesture listener so a top-left corner tap opens "
"your desktop screenshot tool (GNOME, Spectacle, and peers)."
msgstr ""
"Yana shigar da mai sauraron alamar Share ta touchpad don taɓawa a kusurwar "
"sama-hagu ta buɗe kayan aikin hoton allo na desktop (GNOME, Spectacle da "
"makamantansu)."

#: lib/install-selection.sh:197
#, sh-format
msgid ""
"Invalid selection: %s. Enter numbers (1,2,3,4), component names, all, or "
"none."
msgstr ""
"Zaɓi marar inganci: %s. Shigar da lambobi (1,2,3,4), sunayen sassa, ko all, "
"ko none."

#: lib/install-kde.sh:309
msgid "KDE Plasma shortcuts configured."
msgstr "KDE Plasma an saita gajerun hanyoyin."

#: lib/install-lxqt.sh:586
msgid "LXQt Global Keys configured."
msgstr "LXQt Global Keys an saita su."

#: lib/install-mate.sh:209
