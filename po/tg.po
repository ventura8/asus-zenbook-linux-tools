#: bin/asus_install_selection_tui.py:528
#, python-format
msgid ""
"Select only the components you use. Unselected services and shortcuts will "
"not be installed."
msgstr ""
"Танҳо ҷузъҳоеро, ки шумо истифода мебаред, интихоб кунед. Хидматҳо ва "
"миёнабурҳои интихобнашуда насб карда намешаванд."

#: lib/install-selection.sh:164
msgid "Select only what you use to avoid unnecessary services and shortcuts."
msgstr ""
"Танҳо он чизеро, ки шумо истифода мебаред, интихоб кунед, то аз хидматҳои "
"нолозим ва миёнабурҳо канорагирӣ кунед."

#: lib/install-gnome.sh:333
msgid ""
"Shortcuts registered for Print/Super-Shift-s, XF86Launch1/XF86Tools, and "
"XF86Display (F8 left unchanged)."
msgstr ""
"Миёнабурҳо барои Print/Super-Shift-s, XF86Launch1/XF86Tools ва XF86Display "
"ба қайд гирифта шудаанд (F8 бетағйир монд)."

#: lib/install-components.sh:543
msgid "Sound fix installed with a suspend and resume hook."
msgstr "Ислоҳи садо бо қалмоқчаи таваққуф ва дубора насб карда шудааст."

#: lib/install-selection-tui.sh:25
msgid "Space selects a component. Enter confirms. Esc cancels."
msgstr "Space қисмро интихоб мекунад. Enter тасдиқ мекунад. Esc бекор мекунад."

#: lib/install-selection.sh:186
msgid "Text selection mode."
msgstr "Ҳолати интихоби матн."

#: lib/install-selection.sh:177
msgid "The interface language follows your desktop session."
msgstr "Забони интерфейс сеанси мизи кории шуморо пайгирӣ мекунад."

#: lib/install-os-detection.sh:566
msgid ""
"This can take a few minutes while packages are downloaded and installed."
msgstr "Ҳангоми зеркашӣ ва насб шудани бастаҳо ин метавонад чанд дақиқа гирад."

#: lib/install-components.sh:425
msgid ""
"Touchpad Share gesture listener installed (active state not verified in this "
"environment)."
msgstr ""
"Шунавандаи имову ишораи сенсорӣ насб карда шудааст (ҳолати фаъол дар ин "
"муҳит тасдиқ нашудааст)."

#: lib/install-components.sh:420
msgid "Touchpad Share gesture listener installed and active."
msgstr "Сенсорӣ шунавандаи имову ишора насб ва фаъол."

#: lib/install-components.sh:68
msgid ""
"WMI Hotkey daemon installed (active state not verified in this environment)."
msgstr ""
"Демони WMI Hotkey насб карда шудааст (ҳолати фаъол дар ин муҳит тасдиқ "
"нашудааст)."

#: lib/install-components.sh:63
msgid "WMI Hotkey daemon installed and active."
msgstr "WMI Hotkey демон насб ва фаъол."

