msgstr ""
"Đã cài đặt trình nghe cử chỉ Chia sẻ bàn di chuột (trạng thái hoạt động chưa "
"được xác minh trong môi trường này)."

#: lib/install-components.sh:420
msgid "Touchpad Share gesture listener installed and active."
msgstr "Trình nghe cử chỉ Chia sẻ bàn di chuột đã được cài đặt và hoạt động."

#: lib/install-components.sh:68
msgid ""
"WMI Hotkey daemon installed (active state not verified in this environment)."
msgstr ""
"Đã cài đặt daemon WMI Hotkey (trạng thái hoạt động chưa được xác minh trong "
"môi trường này)."

#: lib/install-components.sh:63
msgid "WMI Hotkey daemon installed and active."
msgstr "Daemon WMI Hotkey được cài đặt và hoạt động."

