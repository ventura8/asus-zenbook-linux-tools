#: bin/asus_install_selection_tui.py:525
#, python-format
msgid "Installing ASUS ZenBook Linux Tools %s."
msgstr "Ke hoʻokomo nei i nā mea hana ASUS ZenBook Linux %s."

#: lib/install-selection.sh:165
msgid ""
"Installs the WMI hotkey daemon for ScreenPad brightness, fan Quiet/Balanced/"
"Performance, camera privacy, and window swap across monitors."
msgstr ""
"Hoʻokomo i ka daemon hotkey WMI no ka ʻālohilohi ScreenPad, ka peʻahi Quiet/"
"Balanced/Performance, ka pilikino kāmela, a me ka hoʻololi puka ma waena o "
"nā monitor."

#: lib/install-selection.sh:169
msgid ""
"Installs the speaker amplifier fix and a suspend/resume hook so supported "
"ZenBook audio recovers after boot and after sleep."
msgstr ""
"Hoʻokomo i ka hoʻoponopono amplifier leo a me kahi hook suspend/resume i "
"hiki ai i ke kani ZenBook i kākoʻo ʻia ke ola hou ma hope o ka boot a ma "
"hope o ka hiamoe."

#: lib/install-selection.sh:167
msgid ""
"Installs the touchpad Share gesture listener so a top-left corner tap opens "
"your desktop screenshot tool (GNOME, Spectacle, and peers)."
msgstr ""
"Hoʻokomo i ka listener gesture Share o ka touchpad i wehe ai ke paʻi ʻana ma "
"ke kihi hema luna i kāu mea hana screenshot desktop (GNOME, Spectacle, a me "
"nā hoa)."

#: lib/install-selection.sh:193
#, sh-format
msgid ""
"Invalid selection: %s. Enter numbers (1,2,3,4), component names, or all."
msgstr ""
"Koho hewa: %s. E hoʻokomo i nā helu (1,2,3,4), nā inoa ʻāpana, a i ʻole all."

