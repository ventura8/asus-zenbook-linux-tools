#: lib/install-selection.sh:190
msgid ""
"Press Enter to install all recommended components, or enter 'all' or 'none'."
msgstr ""
"Tina Enter mpo kotya biloko nyonso oyo epesami conseil, to kotia 'all' tǒ "
"'none'."

#: bin/asus-fan-toggle.sh:95
msgid "Quiet (Silent)"
msgstr "Kimya (Ezali kimia) ."

