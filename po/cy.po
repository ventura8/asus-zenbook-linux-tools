#: bin/asus_install_selection_tui.py:526
#, python-format
msgid "Installing ASUS ZenBook Linux Tools %s."
msgstr "Gosod Offer ASUS ZenBook Linux %s."

#: lib/install-selection.sh:169
msgid ""
"Installs the WMI hotkey daemon for ScreenPad brightness, fan Quiet/Balanced/"
"Performance, camera privacy, and window swap across monitors."
msgstr ""
"Gosoda'r daemon bysellau poeth WMI ar gyfer disgleirdeb ScreenPad, ffan "
"Quiet/Balanced/Performance, preifatrwydd camera, a chyfnewid ffenestri ar "
"draws monitroedd."

#: lib/install-selection.sh:173
msgid ""
"Installs the speaker amplifier fix and a suspend/resume hook so supported "
"ZenBook audio recovers after boot and after sleep."
msgstr ""
"Gosoda'r trwsio chwyddwr siaradwr a bachyn suspend/resume fel bod sain "
"ZenBook a gefnogir yn adfer ar ôl cychwyn ac ar ôl cysgu."

#: lib/install-selection.sh:171
msgid ""
"Installs the touchpad Share gesture listener so a top-left corner tap opens "
"your desktop screenshot tool (GNOME, Spectacle, and peers)."
msgstr ""
"Gosoda wrandäwr ystum Share y pad cyffwrdd fel bod tap yn y gornel chwith "
"uchaf yn agor offeryn sgrinlun y bwrdd gwaith (GNOME, Spectacle a thebyg)."

#: lib/install-selection.sh:197
