#: bin/asus_install_selection_tui.py:528
#, python-format
msgid ""
"Select only the components you use. Unselected services and shortcuts will "
"not be installed."
msgstr ""
"Dewiswch y cydrannau rydych chi'n eu defnyddio yn unig. Ni fydd gwasanaethau "
"heb eu dewis a llwybrau byr yn cael eu gosod."

#: lib/install-selection.sh:164
msgid "Select only what you use to avoid unnecessary services and shortcuts."
msgstr ""
"Dewiswch yr hyn rydych chi'n ei ddefnyddio yn unig i osgoi gwasanaethau a "
"llwybrau byr diangen."

#: lib/install-gnome.sh:333
msgid ""
"Shortcuts registered for Print/Super-Shift-s, XF86Launch1/XF86Tools, and "
"XF86Display (F8 left unchanged)."
msgstr ""
"Llwybrau byr wedi'u cofrestru ar gyfer Print/Super-Shift-s, XF86Launch1/"
"XF86Tools, a XF86Display (F8 heb ei newid)."

#: lib/install-components.sh:543
msgid "Sound fix installed with a suspend and resume hook."
msgstr "Atgyweiriad sain wedi'i osod gyda bachyn crog ac ailddechrau."

#: lib/install-selection-tui.sh:25
msgid "Space selects a component. Enter confirms. Esc cancels."
msgstr "Space yn dewis cydran. Enter yn cadarnhau. Esc yn canslo."

#: lib/install-selection.sh:186
msgid "Text selection mode."
msgstr "Modd dewis testun."

#: lib/install-selection.sh:177
msgid "The interface language follows your desktop session."
msgstr "Mae iaith y rhyngwyneb yn dilyn eich sesiwn bwrdd gwaith."

#: lib/install-os-detection.sh:566
msgid ""
"This can take a few minutes while packages are downloaded and installed."
msgstr ""
"Gall hyn gymryd ychydig funudau tra bod pecynnau'n cael eu lawrlwytho a'u "
"gosod."

#: lib/install-components.sh:425
msgid ""
"Touchpad Share gesture listener installed (active state not verified in this "
