msgstr ""
"Gwrandäwr ystum Touchpad Share wedi'i osod (cyflwr gweithredol heb ei wirio "
"yn yr amgylchedd hwn)."

#: lib/install-components.sh:420
msgid "Touchpad Share gesture listener installed and active."
msgstr "Gwrandäwr ystum Touchpad Share wedi'i osod ac yn weithredol."

#: lib/install-components.sh:68
