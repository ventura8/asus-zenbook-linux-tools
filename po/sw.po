#: bin/asus_install_selection_tui.py:525
#, python-format
msgid "Installing ASUS ZenBook Linux Tools %s."
msgstr "Inasakinisha Zana za Linux za ASUS ZenBook %s."

#: lib/install-selection.sh:165
msgid ""
"Installs the WMI hotkey daemon for ScreenPad brightness, fan Quiet/Balanced/"
"Performance, camera privacy, and window swap across monitors."
msgstr ""
"Inasakinisha daemon ya vitufe vya haraka vya WMI kwa mwangaza wa ScreenPad, "
"feni Quiet/Balanced/Performance, faragha ya kamera na ubadilishaji wa "
"madirisha kati ya monitor."

#: lib/install-selection.sh:169
msgid ""
"Installs the speaker amplifier fix and a suspend/resume hook so supported "
"ZenBook audio recovers after boot and after sleep."
msgstr ""
"Inasakinisha marekebisho ya amp ya spika na ndoano ya suspend/resume ili "
"sauti ya ZenBook inayotumika irejee baada ya boot na baada ya usingizi."

#: lib/install-selection.sh:167
msgid ""
"Installs the touchpad Share gesture listener so a top-left corner tap opens "
"your desktop screenshot tool (GNOME, Spectacle, and peers)."
msgstr ""
"Inasakinisha kisikilizaji cha ishara ya Share ya touchpad ili kugusa kona ya "
"juu kushoto kufungue zana ya picha ya skrini ya eneo-kazi (GNOME, Spectacle "
"na zinazofanana)."

#: lib/install-selection.sh:193
#, sh-format
msgid ""
"Invalid selection: %s. Enter numbers (1,2,3,4), component names, or all."
msgstr ""
"Uchaguzi batili: %s. Weka nambari (1,2,3,4), majina ya vipengele, au all."

