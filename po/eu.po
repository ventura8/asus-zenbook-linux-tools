#: bin/asus_install_selection_tui.py:525
#, python-format
msgid "Installing ASUS ZenBook Linux Tools %s."
msgstr "ASUS ZenBook Linux tresnak instalatzen %s."

#: lib/install-selection.sh:169
msgid ""
"Installs the WMI hotkey daemon for ScreenPad brightness, fan Quiet/Balanced/"
"Performance, camera privacy, and window swap across monitors."
msgstr ""
"WMI laster-tekla demonioa instalatzen du ScreenPad distirarako, Quiet/"
"Balanced/Performance haizagailurako, kameraren pribatutasunerako eta "
"monitoreen arteko leiho-trukarako."

#: lib/install-selection.sh:173
msgid ""
"Installs the speaker amplifier fix and a suspend/resume hook so supported "
"ZenBook audio recovers after boot and after sleep."
msgstr ""
"Bozgorailu-anplifikadorearen konponketa eta suspend/resume kakoa instalatzen "
"ditu, onartutako ZenBook audioa abiarazi eta loaren ondoren berreskura dadin."

#: lib/install-selection.sh:171
msgid ""
"Installs the touchpad Share gesture listener so a top-left corner tap opens "
"your desktop screenshot tool (GNOME, Spectacle, and peers)."
msgstr ""
"Ukimen-panelaren Share keinuen entzulea instalatzen du, goiko ezkerreko "
"izkinako ukitu batek mahaigaineko pantaila-argazki tresna irek dezan (GNOME, "
"Spectacle eta antzekoak)."

#: lib/install-selection.sh:197
#, sh-format
