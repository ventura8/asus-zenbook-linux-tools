#: bin/asus_install_selection_tui.py:525
#, python-format
msgid "Installing ASUS ZenBook Linux Tools %s."
msgstr "Instalimi i ASUS ZenBook Linux Tools %s."

#: lib/install-selection.sh:169
msgid ""
"Installs the WMI hotkey daemon for ScreenPad brightness, fan Quiet/Balanced/"
"Performance, camera privacy, and window swap across monitors."
msgstr ""
"Instalon demonin e tastave të shpejta WMI për ndriçimin ScreenPad, "
"ventilatorin Quiet/Balanced/Performance, privatësinë e kamerës dhe "
"shkëmbimin e dritareve ndërmjet monitorëve."

#: lib/install-selection.sh:173
msgid ""
"Installs the speaker amplifier fix and a suspend/resume hook so supported "
"ZenBook audio recovers after boot and after sleep."
msgstr ""
"Instalon ndreqjen e amplifikatorit të altoparlantëve dhe një grepa suspend/"
"resume që audio ZenBook e mbështetur të rikuperohet pas nisjes dhe pas "
"gjumit."

#: lib/install-selection.sh:171
msgid ""
"Installs the touchpad Share gesture listener so a top-left corner tap opens "
"your desktop screenshot tool (GNOME, Spectacle, and peers)."
msgstr ""
"Instalon dëgjuesin e gjestit Share të touchpad-it që një prekje në këndin e "
"sipërm majtas të hapë mjetin e pamjeve të ekranit të desktopit (GNOME, "
"Spectacle dhe të ngjashme)."

#: lib/install-selection.sh:197
#, sh-format
