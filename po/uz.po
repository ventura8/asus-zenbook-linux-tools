#: bin/asus_install_selection_tui.py:525
#, python-format
msgid "Installing ASUS ZenBook Linux Tools %s."
msgstr "ASUS ZenBook Linux asboblarini o'rnatish %s."

#: lib/install-selection.sh:165
msgid ""
"Installs the WMI hotkey daemon for ScreenPad brightness, fan Quiet/Balanced/"
"Performance, camera privacy, and window swap across monitors."
msgstr ""
"ScreenPad yorqinligi, Quiet/Balanced/Performance ventilyator, kamera "
"maxfiyligi va monitorlar o‘rtasida oynani almashtirish uchun WMI hotkey "
"daemon o‘rnatadi."

#: lib/install-selection.sh:169
msgid ""
"Installs the speaker amplifier fix and a suspend/resume hook so supported "
"ZenBook audio recovers after boot and after sleep."
msgstr ""
"Qo‘llab-quvvatlanadigan ZenBook audiosi yuklanishdan keyin va uyqudan keyin "
"tiklanishi uchun dinamik kuchaytirgich tuzatmasini va suspend/resume hook "
"o‘rnatadi."

#: lib/install-selection.sh:167
msgid ""
"Installs the touchpad Share gesture listener so a top-left corner tap opens "
"your desktop screenshot tool (GNOME, Spectacle, and peers)."
msgstr ""
"Yuqori-chap burchakka bosganda ish stoli skrinshot vositasi (GNOME, "
"Spectacle va o‘xshashlar) ochilishi uchun touchpad Share ishora listener "
"o‘rnatadi."

#: lib/install-selection.sh:193
#, sh-format
msgid ""
"Invalid selection: %s. Enter numbers (1,2,3,4), component names, or all."
msgstr ""
"Noto‘g‘ri tanlov: %s. Raqamlar (1,2,3,4), komponent nomlari yoki all "
"kiriting."

