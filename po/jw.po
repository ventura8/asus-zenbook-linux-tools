msgstr ""
"Pencet Enter kanggo nginstal kabeh komponen sing disaranake, utawa tulis "
"'all'."

#: bin/asus-fan-toggle.sh:95
msgid "Quiet (Silent)"
msgstr "Sepi (Senyap)"

#: bin/asus-screenpad-toggle.sh:72
