#: bin/asus_install_selection_tui.py:527
#, python-format
msgid ""
"Select only the components you use. Unselected services and shortcuts will "
"not be installed."
msgstr ""
"صرف وہی اجزاء منتخب کریں جو آپ استعمال کرتے ہیں۔ غیر منتخب خدمات اور شارٹ "
"کٹس انسٹال نہیں کیے جائیں گے۔"

#: lib/install-selection.sh:164
msgid "Select only what you use to avoid unnecessary services and shortcuts."
msgstr ""
"غیر ضروری خدمات اور شارٹ کٹس سے بچنے کے لیے صرف وہی منتخب کریں جو آپ استعمال "
"کرتے ہیں۔"

#: lib/install-gnome.sh:333
msgid ""
"Shortcuts registered for Print/Super-Shift-s, XF86Launch1/XF86Tools, and "
