#, python-format
msgid ""
"Select only the components you use. Unselected services and shortcuts will "
"not be installed."
msgstr ""
"Izberite samo komponente, ki jih uporabljate. Neizbrane storitve in "
"bližnjice ne bodo nameščene."

#: lib/install-selection.sh:164
