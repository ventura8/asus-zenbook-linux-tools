#!/bin/bash
# Interactive component configure for the packaged payload under /usr/share.
set -euo pipefail

SHARE_DIR="/usr/share/asus-zenbook-linux-tools"
INSTALL_SH="${SHARE_DIR}/install.sh"

if [ ! -f "$INSTALL_SH" ]; then
    echo "Missing packaged installer: $INSTALL_SH" >&2
    exit 1
fi

export INSTALL_SOURCE_DIR="$SHARE_DIR"
export SKIP_PKG_INSTALL="${SKIP_PKG_INSTALL:-1}"

exec bash "$INSTALL_SH" "$@"
