#!/usr/bin/make -f

export DH_VERBOSE = 1
SHELL := /bin/bash

PKG_SHARE = debian/asus-zenbook-linux-tools/usr/share/asus-zenbook-linux-tools
PKG_SBIN = debian/asus-zenbook-linux-tools/usr/sbin
PKG_BIN = debian/asus-zenbook-linux-tools/usr/bin
PKG_LOCALE = debian/asus-zenbook-linux-tools/usr/share/locale
PKG_APPLICATIONS = debian/asus-zenbook-linux-tools/usr/share/applications
PKG_ICONS = debian/asus-zenbook-linux-tools/usr/share/icons/hicolor/scalable/apps

%:
	dh $@ --buildsystem=none

override_dh_auto_build:
	@echo "No upstream build step (native Python/shell package)."

override_dh_auto_test:
ifeq (,$(findstring nocheck,$(DEB_BUILD_OPTIONS)))
	mkdir -p reports/distro-logs; \
	set -o pipefail; \
	{ \
		set -e; \
		for f in bin/*.sh lib/*.sh install.sh uninstall.sh; do \
			[ -f "$$f" ] || continue; \
			bash -n "$$f"; \
		done; \
		PYTHONPATH=bin:. python3 -m unittest discover -s tests/unit -t . --failfast; \
	} 2>&1 | tee reports/distro-logs/deb-dh-auto-test.log; \
	exit "$${PIPESTATUS[0]}"
else
	@echo "Skipping dh_auto_test (DEB_BUILD_OPTIONS contains nocheck)."
endif

override_dh_auto_install:
	mkdir -p "$(PKG_APPLICATIONS)" "$(PKG_ICONS)"
	"$(CURDIR)/packaging/stage-payload.sh" "$(CURDIR)/debian/asus-zenbook-linux-tools"

override_dh_dwz:
	@echo "Skipping dh_dwz (no native ELF payload)."

override_dh_clean:
	dh_clean
	rm -f reports/distro-logs/deb-dh-auto-test.log
