#!/usr/bin/make -f

export DH_VERBOSE = 1
SHELL := /bin/bash

PKG_SHARE = debian/asus-zenbook-linux-tools/usr/share/asus-zenbook-linux-tools
PKG_SBIN = debian/asus-zenbook-linux-tools/usr/sbin
PKG_BIN = debian/asus-zenbook-linux-tools/usr/bin
PKG_LOCALE = debian/asus-zenbook-linux-tools/usr/share/locale
PKG_APPLICATIONS = debian/asus-zenbook-linux-tools/usr/share/applications
PKG_ICONS = debian/asus-zenbook-linux-tools/usr/share/icons/hicolor/scalable/apps

%:
	dh $@ --buildsystem=none

override_dh_auto_build:
	@echo "No upstream build step (native Python/shell package)."

override_dh_auto_test:
ifeq (,$(findstring nocheck,$(DEB_BUILD_OPTIONS)))
	mkdir -p reports/distro-logs; \
	set -o pipefail; \
	{ \
		set -e; \
		for f in bin/*.sh lib/*.sh install.sh uninstall.sh; do \
			[ -f "$$f" ] || continue; \
			bash -n "$$f"; \
		done; \
		PYTHONPATH=bin:. python3 -m unittest discover -s tests/unit -t . --failfast; \
	} 2>&1 | tee reports/distro-logs/deb-dh-auto-test.log; \
	exit "$${PIPESTATUS[0]}"
else
	@echo "Skipping dh_auto_test (DEB_BUILD_OPTIONS contains nocheck)."
endif

override_dh_auto_install:
	mkdir -p "$(PKG_SHARE)/bin" "$(PKG_SHARE)/lib" "$(PKG_SHARE)/systemd" \
		"$(PKG_SBIN)" "$(PKG_BIN)" "$(PKG_APPLICATIONS)" "$(PKG_ICONS)"
	# Product binaries (preserve daemon symlinks; skip caches)
	find bin -maxdepth 1 -type f ! -name '__init__.py' -exec cp -a {} "$(PKG_SHARE)/bin/" \;
	find bin -maxdepth 1 -type l -exec cp -a {} "$(PKG_SHARE)/bin/" \;
	set -e; shopt -s nullglob; \
	for f in lib/*.sh; do cp -a "$$f" "$(PKG_SHARE)/lib/"; done; \
	for f in systemd/*.service; do cp -a "$$f" "$(PKG_SHARE)/systemd/"; done
	cp -a shared_imports.py VERSION install.sh uninstall.sh "$(PKG_SHARE)/"
	if [ -d gnome ]; then cp -a gnome "$(PKG_SHARE)/"; fi
	if [ -d udev ]; then cp -a udev "$(PKG_SHARE)/"; fi
	mkdir -p "$(PKG_SHARE)/assets/icons" "$(PKG_SHARE)/assets/applications"
	set -e; shopt -s nullglob; \
	for f in assets/icons/asus-*-symbolic.svg; do \
		cp -a "$$f" "$(PKG_SHARE)/assets/icons/"; \
	done
	set -e; shopt -s nullglob; \
	for f in po/*.po; do \
		lang="$${f##*/}"; lang="$${lang%.po}"; \
		out="$(PKG_LOCALE)/$$lang/LC_MESSAGES"; \
		mkdir -p "$$out"; \
		msgfmt -c -o "$$out/asus-zenbook-linux-tools.mo" "$$f"; \
	done; \
	if [ -f "$(PKG_LOCALE)/jw/LC_MESSAGES/asus-zenbook-linux-tools.mo" ]; then \
		mkdir -p "$(PKG_LOCALE)/jv/LC_MESSAGES"; \
		cp -a "$(PKG_LOCALE)/jw/LC_MESSAGES/asus-zenbook-linux-tools.mo" \
			"$(PKG_LOCALE)/jv/LC_MESSAGES/asus-zenbook-linux-tools.mo"; \
	fi
	install -m 0755 debian/asus-zenbook-configure "$(PKG_SBIN)/asus-zenbook-configure"

override_dh_dwz:
	@echo "Skipping dh_dwz (no native ELF payload)."

override_dh_clean:
	dh_clean
	rm -f reports/distro-logs/deb-dh-auto-test.log
