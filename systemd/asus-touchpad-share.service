[Unit]
Description=ASUS Touchpad Share Key Listener
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
# Requires root: reads /dev/input (evdev) and spawns asus-screenshot.sh, which
# uses runuser for session D-Bus / ydotool. Match hotkey-daemon hardening:
# NoNewPrivileges and ProtectSystem=full/strict break runuser (pam_keyinit).
User=root
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/local/bin/asus-touchpad-share.py
Restart=always
RestartSec=3
LockPersonality=yes
RestrictRealtime=yes

ProtectSystem=no
ProtectHome=read-only
# Shared with asus-hotkey-daemon.service (same RuntimeDirectory name).
RuntimeDirectory=asus-zenbook-notif
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
PrivateDevices=no

[Install]
WantedBy=multi-user.target
